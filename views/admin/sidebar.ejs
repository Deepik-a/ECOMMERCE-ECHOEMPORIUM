    <script>
      // Automatically keep the active sidebar route highlighted and open
      document.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname.toLowerCase();
        const productCollapse = document.getElementById('productMenu');
        const productLink = document.getElementById('productMenuLink');

        if (path.includes('/admin/product') || path.includes('/admin/addproduct') || path.includes('/admin/updateproduct')) {
          if (productCollapse) {
            productCollapse.classList.add('show');
          }
          if (productLink) {
            productLink.classList.add('active');
            productLink.setAttribute('aria-expanded', 'true');
          }
          if (path.includes('/admin/addproduct')) {
            const el = document.getElementById('subnav-addproduct');
            if (el) el.classList.add('active');
          } else {
            const el = document.getElementById('subnav-products');
            if (el) el.classList.add('active');
          }
        } else if (path.includes('/admin/dashboard')) {
          const el = document.getElementById('nav-dashboard');
          if (el) el.classList.add('active');
        } else if (path.includes('/admin/categories')) {
          const el = document.getElementById('nav-category');
          if (el) el.classList.add('active');
        } else if (path.includes('/admin/users')) {
          const el = document.getElementById('nav-users');
          if (el) el.classList.add('active');
        } else if (path.includes('/admin/orders')) {
          const el = document.getElementById('nav-orders');
          if (el) el.classList.add('active');
        } else if (path.includes('/admin/coupons')) {
          const el = document.getElementById('nav-coupons');
          if (el) el.classList.add('active');
        } else if (path.includes('/admin/salesreport')) {
          const el = document.getElementById('nav-sales');
          if (el) el.classList.add('active');
        } else if (path.includes('/admin/offer')) {
          const el = document.getElementById('nav-offers');
          if (el) el.classList.add('active');
        }
      });
    </script>
     
