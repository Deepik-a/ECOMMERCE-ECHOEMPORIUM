<%- include('sidebar') %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container-fluid pt-4 px-4 pb-5">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="h4 font-bold text-dark mb-0">Admin Analytics Dashboard</h2>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill d-inline-flex align-items-center">
                    <span class="spinner-grow spinner-grow-sm me-1" style="width: 0.55rem; height: 0.55rem;" role="status"></span> Live Data
                </span>
            </div>
            <p class="text-muted small mb-0 mt-1">Real-time overview of revenue, sales, order trends, inventory, and best-performing products.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <button onclick="window.location.reload()" class="btn btn-sm btn-outline-primary shadow-sm d-flex align-items-center gap-1">
                <i class="fa fa-sync-alt"></i> Refresh Stats
            </button>
            <a href="/admin/salesReport" class="btn btn-sm btn-primary shadow-sm d-flex align-items-center gap-1">
                <i class="fa fa-file-invoice-dollar"></i> Detailed Sales Report
            </a>
        </div>
    </div>

    <!-- 4 Primary KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white hover-shadow transition">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase text-muted fw-semibold small">Total Revenue</span>
                        <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success">
                            <i class="fa fa-wallet fa-lg"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark">₹<%= (summary.totalRevenue || 0).toLocaleString('en-IN') %></h3>
                    <div class="d-flex flex-column gap-1 pt-2 border-top border-light-subtle small text-muted">
                        <div class="d-flex justify-content-between">
                            <span>Today:</span>
                            <span class="fw-semibold text-success">₹<%= (summary.todayRevenue || 0).toLocaleString('en-IN') %></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>This Month:</span>
                            <span class="fw-semibold text-dark">₹<%= (summary.monthlyRevenue || 0).toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Total Orders -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white hover-shadow transition">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase text-muted fw-semibold small">Total Orders</span>
                        <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                            <i class="fa fa-shopping-bag fa-lg"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark"><%= (summary.totalOrders || 0).toLocaleString('en-IN') %></h3>
                    <div class="d-flex flex-column gap-1 pt-2 border-top border-light-subtle small text-muted">
                        <div class="d-flex justify-content-between">
                            <span>Today's Orders:</span>
                            <span class="fw-semibold text-primary"><%= summary.todayOrders || 0 %></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Pending / In Progress:</span>
                            <span class="fw-semibold text-warning"><%= summary.pendingOrders || 0 %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Products Sold -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white hover-shadow transition">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase text-muted fw-semibold small">Products Sold</span>
                        <div class="p-2 rounded-3 bg-info bg-opacity-10 text-info">
                            <i class="fa fa-boxes fa-lg"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark"><%= (summary.totalProductsSold || 0).toLocaleString('en-IN') %> <span class="fs-6 fw-normal text-muted">units</span></h3>
                    <div class="d-flex flex-column gap-1 pt-2 border-top border-light-subtle small text-muted">
                        <div class="d-flex justify-content-between">
                            <span>Active Products:</span>
                            <span class="fw-semibold text-dark"><%= summary.totalProducts || 0 %></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Out of Stock:</span>
                            <span class="fw-semibold <%= summary.outOfStockProducts > 0 ? 'text-danger' : 'text-success' %>"><%= summary.outOfStockProducts || 0 %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Customers & Discounts -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white hover-shadow transition">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase text-muted fw-semibold small">Customers</span>
                        <div class="p-2 rounded-3 bg-warning bg-opacity-10 text-warning">
                            <i class="fa fa-users fa-lg"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark"><%= (summary.totalCustomers || 0).toLocaleString('en-IN') %></h3>
                    <div class="d-flex flex-column gap-1 pt-2 border-top border-light-subtle small text-muted">
                        <div class="d-flex justify-content-between">
                            <span>Active Customers:</span>
                            <span class="fw-semibold text-success"><%= summary.activeCustomers || 0 %></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Coupon Discounts:</span>
                            <span class="fw-semibold text-danger">₹<%= (summary.totalDiscount || 0).toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Sales & Revenue Trend Chart -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-0">Sales & Revenue Analytics</h5>
                        <p class="text-muted small mb-0">Track revenue and order volume over time</p>
                    </div>
                    <!-- Time Filters -->
                    <div class="btn-group btn-group-sm shadow-sm" role="group" id="salesFilterGroup">
                        <button type="button" class="btn btn-outline-secondary" data-filter="daily">Daily</button>
                        <button type="button" class="btn btn-outline-secondary" data-filter="weekly">Weekly</button>
                        <button type="button" class="btn btn-outline-secondary active" data-filter="monthly">Monthly</button>
                        <button type="button" class="btn btn-outline-secondary" data-filter="yearly">Yearly</button>
                    </div>
                </div>
                <div class="card-body px-4 pb-4 pt-3">
                    <div style="height: 320px; position: relative;">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Status Distribution -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="card-title fw-bold text-dark mb-0">Order Status Breakdown</h5>
                    <p class="text-muted small mb-0">Distribution by fulfillment status</p>
                </div>
                <div class="card-body px-4 pb-4 pt-2 d-flex flex-column justify-content-between">
                    <div style="height: 220px; position: relative;" class="my-auto">
                        <canvas id="orderStatusChart"></canvas>
                    </div>
                    <div class="mt-3 pt-3 border-top border-light-subtle">
                        <div class="row g-2 text-center small">
                            <div class="col-4">
                                <div class="p-2 rounded bg-light">
                                    <div class="text-muted small">Paid / Done</div>
                                    <div class="fw-bold text-success"><%= (orderStatusMap['Delivered'] || 0) + (orderStatusMap['Paid'] || 0) %></div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light">
                                    <div class="text-muted small">Pending</div>
                                    <div class="fw-bold text-warning"><%= orderStatusMap['Pending'] || 0 %></div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light">
                                    <div class="text-muted small">Cancelled</div>
                                    <div class="fw-bold text-danger"><%= orderStatusMap['Cancelled'] || 0 %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Sales & Top Categories Row -->
    <div class="row g-4 mb-4">
        <!-- Category Sales Chart -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="card-title fw-bold text-dark mb-0">Revenue by Category</h5>
                    <p class="text-muted small mb-0">Performance comparison across store categories</p>
                </div>
                <div class="card-body px-4 pb-4 pt-3">
                    <div style="height: 280px; position: relative;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 10 Best Selling Categories Leaderboard -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-0">Top Categories</h5>
                        <p class="text-muted small mb-0">Ranked by volume and sales</p>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary">Top <%= topCategories.length %></span>
                </div>
                <div class="card-body px-4 pb-4 pt-2">
                    <div class="list-group list-group-flush">
                        <% if (topCategories && topCategories.length > 0) { %>
                            <% topCategories.forEach(function(cat, index) { %>
                                <div class="list-group-item px-0 py-2 border-light-subtle d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge rounded-circle d-flex align-items-center justify-content-center <%= index === 0 ? 'bg-warning text-dark' : index === 1 ? 'bg-secondary text-white' : index === 2 ? 'bg-bronze text-white' : 'bg-light text-muted' %>" style="width: 24px; height: 24px; font-size: 11px;">
                                            <%= index + 1 %>
                                        </span>
                                        <div>
                                            <h6 class="mb-0 fw-semibold text-dark"><%= cat.name %></h6>
                                            <span class="text-muted small"><%= cat.totalSold %> units sold</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-success">₹<%= (cat.totalRevenue || 0).toLocaleString('en-IN') %></span>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-muted text-center py-4">No category sales recorded yet.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top 10 Best Selling Products Table -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-0">Top 10 Best-Selling Products</h5>
                        <p class="text-muted small mb-0">Most popular products by units sold and generated revenue</p>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Real-time ranking</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Rank</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Units Sold</th>
                                    <th class="pe-4 text-end">Total Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (topProducts && topProducts.length > 0) { %>
                                    <% topProducts.forEach(function(item, index) { %>
                                        <tr>
                                            <td class="ps-4">
                                                <span class="badge rounded-pill <%= index === 0 ? 'bg-warning text-dark' : index === 1 ? 'bg-secondary text-white' : index === 2 ? 'bg-danger text-white' : 'bg-light text-dark border' %> px-2 py-1">
                                                    #<%= index + 1 %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <% if (item.product && item.product.imgArray && item.product.imgArray.length > 0) { %>
                                                        <img src="/uploads/<%= item.product.imgArray[0] %>" alt="<%= item.product.name %>" class="rounded object-fit-cover shadow-sm" style="width: 44px; height: 44px;" onerror="this.src='/public/assets/logo.png'">
                                                    <% } else { %>
                                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 44px; height: 44px;">
                                                            <i class="fa fa-image"></i>
                                                        </div>
                                                    <% } %>
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold text-dark"><%= item.product ? item.product.name : 'Unknown Product' %></h6>
                                                        <span class="text-muted small">ID: <%= item._id %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border"><%= item.category ? item.category.name : 'General' %></span>
                                            </td>
                                            <td class="fw-semibold">
                                                ₹<%= item.product ? (item.product.finalPrice || item.product.price || 0).toLocaleString('en-IN') : '-' %>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 font-monospace fs-6">
                                                    <%= item.totalSold %>
                                                </span>
                                            </td>
                                            <td class="pe-4 text-end fw-bold text-success">
                                                ₹<%= (item.totalRevenue || 0).toLocaleString('en-IN') %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">No product sales data recorded yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders Live Table -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-0">Recent Orders</h5>
                        <p class="text-muted small mb-0">Latest orders placed on the store</p>
                    </div>
                    <a href="/admin/orders" class="btn btn-sm btn-outline-primary">View All Orders</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Order ID</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Payment Method</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (recentOrders && recentOrders.length > 0) { %>
                                    <% recentOrders.forEach(function(order) { %>
                                        <tr>
                                            <td class="ps-4 fw-semibold font-monospace text-primary">
                                                <%= order.orderId || order._id.toString().slice(-8) %>
                                            </td>
                                            <td>
                                                <div>
                                                    <div class="fw-semibold text-dark"><%= order.userId ? order.userId.name : 'Customer' %></div>
                                                    <div class="text-muted small"><%= order.userId ? order.userId.email : 'N/A' %></div>
                                                </div>
                                            </td>
                                            <td class="text-muted small">
                                                <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    <%= order.paymentMethod %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (order.status === 'Delivered' || order.status === 'Paid') { %>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><%= order.status %></span>
                                                <% } else if (order.status === 'Pending') { %>
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1"><%= order.status %></span>
                                                <% } else if (order.status === 'Shipped') { %>
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1"><%= order.status %></span>
                                                <% } else if (order.status === 'Cancelled' || order.status === 'Returned') { %>
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1"><%= order.status %></span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary px-2 py-1"><%= order.status %></span>
                                                <% } %>
                                            </td>
                                            <td class="fw-bold text-dark">
                                                ₹<%= (order.totalPrice || 0).toLocaleString('en-IN') %>
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-light border shadow-sm">
                                                    <i class="fa fa-eye me-1"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">No recent orders found.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.bg-bronze {
    background-color: #cd7f32 !important;
}
.hover-shadow:hover {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    transform: translateY(-2px);
}
.transition {
    transition: all 0.2s ease-in-out;
}
</style>

<!-- Chart.js Real-time Dashboard Scripts -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    // Initial Data from Server
    const initialSales = <%- JSON.stringify(initialSalesChart) %>;
    const orderStatusMap = <%- JSON.stringify(orderStatusMap) %>;
    const categorySales = <%- JSON.stringify(categorySales) %>;

    // 1. Sales & Revenue Trend Chart (Dual Axis: Revenue Line + Orders Bar)
    const salesCtx = document.getElementById('salesChart').getContext('2d');
    
    // Create Revenue Gradient
    const revenueGradient = salesCtx.createLinearGradient(0, 0, 0, 300);
    revenueGradient.addColorStop(0, 'rgba(59, 130, 246, 0.25)');
    revenueGradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

    let salesChart = new Chart(salesCtx, {
        type: 'line',
        data: {
            labels: initialSales.labels && initialSales.labels.length ? initialSales.labels : ['No Data'],
            datasets: [
                {
                    label: 'Revenue (₹)',
                    data: initialSales.revenueData && initialSales.revenueData.length ? initialSales.revenueData : [0],
                    borderColor: '#2563eb',
                    backgroundColor: revenueGradient,
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.35,
                    yAxisID: 'y',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointBackgroundColor: '#2563eb'
                },
                {
                    label: 'Orders Count',
                    type: 'bar',
                    data: initialSales.orderData && initialSales.orderData.length ? initialSales.orderData : [0],
                    backgroundColor: 'rgba(16, 185, 129, 0.65)',
                    borderRadius: 4,
                    barThickness: 18,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: {
                        usePointStyle: true,
                        boxWidth: 8
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            if (context.dataset.yAxisID === 'y') {
                                return 'Revenue: ₹' + Number(context.raw || 0).toLocaleString('en-IN');
                            }
                            return 'Orders: ' + context.raw;
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false }
                },
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return '₹' + Number(value).toLocaleString('en-IN');
                        }
                    },
                    grid: {
                        color: 'rgba(0,0,0,0.05)'
                    }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    beginAtZero: true,
                    grid: { drawOnChartArea: false },
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });

    // Handle Time Filter Button Clicks
    const filterButtons = document.querySelectorAll('#salesFilterGroup button');
    filterButtons.forEach(btn => {
        btn.addEventListener('click', async function () {
            filterButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const filter = this.getAttribute('data-filter');

            try {
                const response = await fetch(`/admin/dashboard-data?filter=${filter}`);
                const data = await response.json();
                if (data.success && data.salesChart) {
                    salesChart.data.labels = data.salesChart.labels.length ? data.salesChart.labels : ['No Data'];
                    salesChart.data.datasets[0].data = data.salesChart.revenueData.length ? data.salesChart.revenueData : [0];
                    salesChart.data.datasets[1].data = data.salesChart.orderData.length ? data.salesChart.orderData : [0];
                    salesChart.update();
                }
            } catch (err) {
                console.error('Failed to update sales chart:', err);
            }
        });
    });

    // 2. Order Status Doughnut Chart
    const statusLabels = Object.keys(orderStatusMap);
    const statusCounts = Object.values(orderStatusMap);
    const statusColors = {
        'Delivered': '#10b981',
        'Paid': '#3b82f6',
        'Shipped': '#06b6d4',
        'Pending': '#f59e0b',
        'Cancelled': '#ef4444',
        'Returned': '#8b5cf6'
    };
    const bgColors = statusLabels.map(st => statusColors[st] || '#9ca3af');

    const statusCtx = document.getElementById('orderStatusChart').getContext('2d');
    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: statusLabels.length ? statusLabels : ['No Orders'],
            datasets: [{
                data: statusCounts.length ? statusCounts : [1],
                backgroundColor: bgColors.length ? bgColors : ['#e5e7eb'],
                borderWidth: 2,
                borderColor: '#ffffff',
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        boxWidth: 8,
                        padding: 12
                    }
                }
            },
            cutout: '70%'
        }
    });

    // 3. Category Revenue Chart
    const catLabels = categorySales.map(c => c._id);
    const catRevenue = categorySales.map(c => c.totalRevenue);
    const catCtx = document.getElementById('categoryChart').getContext('2d');

    new Chart(catCtx, {
        type: 'bar',
        data: {
            labels: catLabels.length ? catLabels : ['No Data'],
            datasets: [{
                label: 'Revenue (₹)',
                data: catRevenue.length ? catRevenue : [0],
                backgroundColor: [
                    'rgba(59, 130, 246, 0.8)',
                    'rgba(16, 185, 129, 0.8)',
                    'rgba(245, 158, 11, 0.8)',
                    'rgba(139, 92, 246, 0.8)',
                    'rgba(236, 72, 153, 0.8)',
                    'rgba(20, 184, 166, 0.8)'
                ],
                borderRadius: 6,
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function (ctx) {
                            return 'Revenue: ₹' + Number(ctx.raw || 0).toLocaleString('en-IN');
                        }
                    }
                }
            },
            scales: {
                x: { grid: { display: false } },
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (val) {
                            return '₹' + Number(val).toLocaleString('en-IN');
                        }
                    },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });
});
</script>