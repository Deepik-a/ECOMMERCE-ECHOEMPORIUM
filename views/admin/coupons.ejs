<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Console</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --primary-navy: #0f172a;
            --primary-accent: #2563eb;
            --surface-bg: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--surface-bg);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .main-content {
            margin-left: 250px;
            padding: 2rem 2.5rem;
            transition: all 0.3s ease;
        }


        @media (max-width: 991.98px) {
            .main-content {
                margin-left: 0;
                padding: 1.25rem 1rem;
            }
        }

        .page-header-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-radius: 1rem;
            padding: 1.5rem 2rem;
            color: #ffffff;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15);
            margin-bottom: 2rem;
        }

        .data-card {
            background: var(--card-bg);
            border-radius: 1rem;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .custom-table {
            margin-bottom: 0;
            width: 100%;
        }

        .custom-table thead th {
            background-color: #f1f5f9;
            color: #475569;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        .custom-table tbody td {
            padding: 1.1rem 1.25rem;
            vertical-align: middle;
            color: #334155;
            font-size: 0.875rem;
            border-bottom: 1px solid #f1f5f9;
            background-color: #ffffff;
        }

        .custom-table tbody tr:hover td {
            background-color: #f8fafc;
        }

        .code-badge {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 0.35rem 0.65rem;
            border-radius: 0.5rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .badge-type-percentage {
            background-color: #fdf4ff;
            color: #a21caf;
            border: 1px solid #f5d0fe;
            font-weight: 600;
            padding: 0.35rem 0.65rem;
            border-radius: 0.5rem;
        }

        .badge-type-fixed {
            background-color: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
            font-weight: 600;
            padding: 0.35rem 0.65rem;
            border-radius: 0.5rem;
        }

        .badge-status-active {
            background-color: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
            padding: 0.3rem 0.65rem;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 0.75rem;
        }

        .badge-status-inactive {
            background-color: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
            padding: 0.3rem 0.65rem;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 0.75rem;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.5rem;
            transition: all 0.2s ease;
            border: none;
            background: #f1f5f9;
            color: #475569;
            text-decoration: none;
        }

        .action-btn:hover {
            transform: translateY(-2px);
        }

        .action-btn-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .action-btn-toggle:hover {
            background: #fef3c7;
            color: #d97706;
        }

        .action-btn-delete:hover {
            background: #fee2e2;
            color: #dc2626;
        }

        /* Modal Customizations */
        .modal-content {
            border-radius: 1.25rem;
            border: none;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
        }

        .modal-header {
            background: #0f172a;
            color: #ffffff;
            padding: 1.25rem 1.75rem;
            border-bottom: none;
        }

        .modal-header .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        .modal-body {
            padding: 1.75rem;
            background-color: #ffffff;
        }

        .form-label {
            font-size: 0.8125rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        .form-control, .form-select {
            border-radius: 0.625rem;
            border: 1.5px solid #cbd5e1;
            padding: 0.65rem 0.875rem;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #ef4444;
            background-image: none;
        }

        .form-control.is-valid, .form-select.is-valid {
            border-color: #10b981;
            background-image: none;
        }

        .error-feedback {
            font-size: 0.75rem;
            color: #ef4444;
            margin-top: 0.3rem;
            display: none;
            font-weight: 500;
        }

        .error-feedback.visible {
            display: block;
        }

        .helper-hint {
            font-size: 0.75rem;
            color: #64748b;
            margin-top: 0.25rem;
        }

        /* Pagination */
        .custom-pagination .page-link {
            border-radius: 0.5rem;
            margin: 0 0.2rem;
            border: 1px solid var(--border-color);
            color: #334155;
            font-weight: 600;
            padding: 0.5rem 0.85rem;
            font-size: 0.875rem;
        }

        .custom-pagination .page-item.active .page-link {
            background-color: var(--primary-accent);
            border-color: var(--primary-accent);
            color: #ffffff;
        }
    </style>
</head>
<body>

    <%- include('sidebar') %>

    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header-card d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h3 class="fw-bold mb-1"><i class="fa fa-ticket-alt me-2 text-primary"></i>Coupon Management</h3>
                <p class="text-white-50 small mb-0">Create, monitor, and manage promotional coupon codes with strict validation rules.</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-primary px-3.5 py-2 rounded-3 shadow-sm fw-semibold d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addCouponModal">
                    <i class="fa fa-plus-circle"></i>
                    <span>Add New Coupon</span>
                </button>
            </div>
        </div>

        <!-- Filter & Search Bar -->
        <div class="data-card p-3 mb-4">
            <form action="/admin/coupons" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa fa-search"></i></span>
                        <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by coupon code..." class="form-control border-start-0 ps-0">
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark px-4 fw-semibold">Search</button>
                    <% if (search) { %>
                        <a href="/admin/coupons" class="btn btn-outline-secondary ms-1">Clear</a>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Coupon Table Card -->
        <div class="data-card">
            <div class="table-responsive">
                <table class="custom-table table">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">#</th>
                            <th>Coupon Code</th>
                            <th>Type</th>
                            <th>Discount</th>
                            <th>Usage Limit</th>
                            <th>Min Order</th>
                            <th>Valid Window</th>
                            <th>Status</th>
                            <th class="text-center" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (coupons && coupons.length > 0) { %>
                            <% coupons.forEach((coupon, index) => { %>
                                <tr>
                                    <td class="text-center font-monospace text-muted fw-bold">
                                        <%= (currentPage - 1) * 10 + index + 1 %>
                                    </td>
                                    <td>
                                        <div class="code-badge">
                                            <i class="fa fa-tag text-primary"></i>
                                            <span><%= coupon.code %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="<%= coupon.discountType === 'Percentage' ? 'badge-type-percentage' : 'badge-type-fixed' %>">
                                            <%= coupon.discountType %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <% if (coupon.discountType === 'Percentage') { %>
                                                <%= coupon.discountValue %>% Off
                                                <% if (coupon.maxDiscountAmount > 0) { %>
                                                    <div class="small text-muted fw-normal">(Max ₹<%= coupon.maxDiscountAmount %>)</div>
                                                <% } %>
                                            <% } else { %>
                                                ₹<%= coupon.discountValue %> Off
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <span class="badge bg-secondary font-monospace"><%= coupon.timesUsed || 0 %> / <%= coupon.usageCount %></span>
                                            <span class="small text-muted ms-1">uses</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">₹<%= coupon.minimumOrderAmount || 0 %></span>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div class="text-secondary"><i class="fa fa-calendar-check text-success me-1"></i> <%= new Date(coupon.startDate).toLocaleDateString('en-GB') %></div>
                                            <div class="text-secondary"><i class="fa fa-calendar-times text-danger me-1"></i> <%= new Date(coupon.endDate).toLocaleDateString('en-GB') %></div>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (coupon.isActive) { %>
                                            <span class="badge-status-active"><i class="fa fa-circle text-success me-1" style="font-size: 6px;"></i> Active</span>
                                        <% } else { %>
                                            <span class="badge-status-inactive"><i class="fa fa-circle text-danger me-1" style="font-size: 6px;"></i> Inactive</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-1.5">
                                            <button type="button" class="action-btn action-btn-edit" title="Edit Coupon" onclick="openEditCouponModal('<%= coupon._id %>')">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <a href="/admin/statuscoupon?id=<%= coupon._id %>" class="action-btn action-btn-toggle" title="<%= coupon.isActive ? 'Deactivate' : 'Activate' %>">
                                                <i class="bi <%= coupon.isActive ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                                            </a>
                                            <button type="button" class="action-btn action-btn-delete" title="Delete Coupon" onclick="confirmDeleteCoupon('<%= coupon._id %>', '<%= coupon.code %>')">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa fa-ticket-alt fa-3x mb-3 text-secondary opacity-50"></i>
                                        <h6 class="fw-bold">No Coupons Found</h6>
                                        <p class="small mb-0">Create a new coupon or adjust your search filter.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="text-muted small">Page <%= currentPage %> of <%= totalPages %></div>
                    <ul class="pagination custom-pagination mb-0">
                        <% if (currentPage > 1) { %>
                            <li class="page-item"><a class="page-link" href="/admin/coupons?page=<%= currentPage - 1 %>&search=<%= search %>">&laquo; Prev</a></li>
                        <% } %>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" href="/admin/coupons?page=<%= i %>&search=<%= search %>"><%= i %></a>
                            </li>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item"><a class="page-link" href="/admin/coupons?page=<%= currentPage + 1 %>&search=<%= search %>">Next &raquo;</a></li>
                        <% } %>
                    </ul>
                </div>
            <% } %>
        </div>
    </div>

    <!-- ================================= ADD COUPON MODAL ================================= -->
    <div class="modal fade" id="addCouponModal" tabindex="-1" aria-labelledby="addCouponModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addCouponModalLabel"><i class="fa fa-plus-circle text-primary me-2"></i>Create New Coupon</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addCouponForm" novalidate>
                        <div class="row g-3">
                            <!-- Coupon Code -->
                            <div class="col-12 col-md-6">
                                <label for="addCode" class="form-label">Coupon Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addCode" name="code" placeholder="e.g., SAVE20, FESTIVE10" maxlength="20" required autocomplete="off">
                                <div class="helper-hint">4–20 uppercase alphanumeric characters, no spaces or symbols.</div>
                                <div class="error-feedback" id="addCodeError"></div>
                            </div>

                            <!-- Discount Type -->
                            <div class="col-12 col-md-6">
                                <label for="addDiscountType" class="form-label">Discount Type <span class="text-danger">*</span></label>
                                <select class="form-select" id="addDiscountType" name="discountType" required>
                                    <option value="Percentage">Percentage (%)</option>
                                    <option value="Fixed">Fixed Amount (₹)</option>
                                </select>
                                <div class="error-feedback" id="addDiscountTypeError"></div>
                            </div>

                            <!-- Discount Value -->
                            <div class="col-12 col-md-6">
                                <label for="addDiscountValue" class="form-label" id="addDiscountValueLabel">Discount Percentage (%) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="addDiscountValue" name="discountValue" placeholder="e.g., 20" required>
                                <div class="helper-hint" id="addDiscountValueHint">Must be between 1% and 100%.</div>
                                <div class="error-feedback" id="addDiscountValueError"></div>
                            </div>

                            <!-- Max Discount Amount (Percentage Only) -->
                            <div class="col-12 col-md-6" id="addMaxDiscountWrapper">
                                <label for="addMaxDiscountAmount" class="form-label">Max Discount Cap (₹) <span class="text-muted small">(Optional)</span></label>
                                <input type="number" step="0.01" class="form-control" id="addMaxDiscountAmount" name="maxDiscountAmount" placeholder="e.g., 500 (0 for no cap)">
                                <div class="helper-hint">Upper limit of discount for percentage promos.</div>
                                <div class="error-feedback" id="addMaxDiscountAmountError"></div>
                            </div>

                            <!-- Minimum Order Amount -->
                            <div class="col-12 col-md-6">
                                <label for="addMinimumOrderAmount" class="form-label">Minimum Order Amount (₹) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="addMinimumOrderAmount" name="minimumOrderAmount" placeholder="e.g., 500" value="0" required>
                                <div class="helper-hint" id="addMinOrderHint">Minimum order value required to apply coupon.</div>
                                <div class="error-feedback" id="addMinimumOrderAmountError"></div>
                            </div>

                            <!-- Usage Count (Limit per coupon, max 5) -->
                            <div class="col-12 col-md-6">
                                <label for="addUsageCount" class="form-label">Coupon Usage Limit <span class="text-danger">*</span></label>
                                <input type="number" min="1" max="5" class="form-control" id="addUsageCount" name="usageCount" placeholder="1 to 5" value="5" required>
                                <div class="helper-hint">Max allowed redemptions (positive integer, max 5).</div>
                                <div class="error-feedback" id="addUsageCountError"></div>
                            </div>

                            <!-- Start Date -->
                            <div class="col-12 col-md-6">
                                <label for="addStartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="addStartDate" name="startDate" required>
                                <div class="error-feedback" id="addStartDateError"></div>
                            </div>

                            <!-- End Date -->
                            <div class="col-12 col-md-6">
                                <label for="addEndDate" class="form-label">End Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="addEndDate" name="endDate" required>
                                <div class="helper-hint">Must be after Start Date.</div>
                                <div class="error-feedback" id="addEndDateError"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" id="addCouponSubmitBtn" class="btn btn-primary px-4 fw-semibold">Create Coupon</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================= EDIT COUPON MODAL ================================= -->
    <div class="modal fade" id="editCouponModal" tabindex="-1" aria-labelledby="editCouponModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editCouponModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Coupon</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editCouponForm" novalidate>
                        <input type="hidden" id="editCouponId" name="id">
                        <div class="row g-3">
                            <!-- Coupon Code -->
                            <div class="col-12 col-md-6">
                                <label for="editCode" class="form-label">Coupon Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="editCode" name="code" maxlength="20" required autocomplete="off">
                                <div class="helper-hint">4–20 uppercase alphanumeric characters.</div>
                                <div class="error-feedback" id="editCodeError"></div>
                            </div>

                            <!-- Discount Type -->
                            <div class="col-12 col-md-6">
                                <label for="editDiscountType" class="form-label">Discount Type <span class="text-danger">*</span></label>
                                <select class="form-select" id="editDiscountType" name="discountType" required>
                                    <option value="Percentage">Percentage (%)</option>
                                    <option value="Fixed">Fixed Amount (₹)</option>
                                </select>
                                <div class="error-feedback" id="editDiscountTypeError"></div>
                            </div>

                            <!-- Discount Value -->
                            <div class="col-12 col-md-6">
                                <label for="editDiscountValue" class="form-label" id="editDiscountValueLabel">Discount Percentage (%) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="editDiscountValue" name="discountValue" required>
                                <div class="helper-hint" id="editDiscountValueHint">Must be between 1% and 100%.</div>
                                <div class="error-feedback" id="editDiscountValueError"></div>
                            </div>

                            <!-- Max Discount Amount (Percentage Only) -->
                            <div class="col-12 col-md-6" id="editMaxDiscountWrapper">
                                <label for="editMaxDiscountAmount" class="form-label">Max Discount Cap (₹) <span class="text-muted small">(Optional)</span></label>
                                <input type="number" step="0.01" class="form-control" id="editMaxDiscountAmount" name="maxDiscountAmount">
                                <div class="error-feedback" id="editMaxDiscountAmountError"></div>
                            </div>

                            <!-- Minimum Order Amount -->
                            <div class="col-12 col-md-6">
                                <label for="editMinimumOrderAmount" class="form-label">Minimum Order Amount (₹) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="editMinimumOrderAmount" name="minimumOrderAmount" required>
                                <div class="helper-hint" id="editMinOrderHint">Minimum order value required.</div>
                                <div class="error-feedback" id="editMinimumOrderAmountError"></div>
                            </div>

                            <!-- Usage Count (Limit per coupon, max 5) -->
                            <div class="col-12 col-md-6">
                                <label for="editUsageCount" class="form-label">Coupon Usage Limit <span class="text-danger">*</span></label>
                                <input type="number" min="1" max="5" class="form-control" id="editUsageCount" name="usageCount" required>
                                <div class="helper-hint">Positive integer between 1 and 5.</div>
                                <div class="error-feedback" id="editUsageCountError"></div>
                            </div>

                            <!-- Start Date -->
                            <div class="col-12 col-md-6">
                                <label for="editStartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="editStartDate" name="startDate" required>
                                <div class="error-feedback" id="editStartDateError"></div>
                            </div>

                            <!-- End Date -->
                            <div class="col-12 col-md-6">
                                <label for="editEndDate" class="form-label">End Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="editEndDate" name="endDate" required>
                                <div class="error-feedback" id="editEndDateError"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" id="editCouponSubmitBtn" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ======================= REAL-TIME VALIDATION LOGIC =======================

        const todayStr = new Date().toISOString().split('T')[0];

        // Setup min dates
        document.getElementById('addStartDate').min = todayStr;
        document.getElementById('addEndDate').min = todayStr;

        // Validation helper functions
        function validateCodeField(inputEl, errorEl) {
            // Automatically clean input: uppercase and remove spaces/special characters
            let clean = inputEl.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (inputEl.value !== clean) {
                inputEl.value = clean;
            }

            const val = inputEl.value.trim();
            if (!val) {
                showFieldError(inputEl, errorEl, 'Coupon code is required.');
                return false;
            }
            if (val.length < 4) {
                showFieldError(inputEl, errorEl, `Code is too short (${val.length}/4 min chars).`);
                return false;
            }
            if (val.length > 20) {
                showFieldError(inputEl, errorEl, 'Code cannot exceed 20 characters.');
                return false;
            }
            if (!/^[A-Z0-9]{4,20}$/.test(val)) {
                showFieldError(inputEl, errorEl, 'Only uppercase letters (A-Z) and numbers (0-9) are allowed.');
                return false;
            }
            clearFieldError(inputEl, errorEl);
            return true;
        }

        function validateDiscountFields(typeEl, valueEl, minOrderEl, maxCapEl, valueErrorEl, minOrderErrorEl) {
            const type = typeEl.value;
            const val = parseFloat(valueEl.value);
            const minOrder = parseFloat(minOrderEl.value) || 0;

            let isValid = true;

            // Validate discount value
            if (isNaN(val) || val <= 0) {
                showFieldError(valueEl, valueErrorEl, 'Discount value must be a positive number.');
                isValid = false;
            } else if (type === 'Percentage') {
                if (val < 1 || val > 100) {
                    showFieldError(valueEl, valueErrorEl, 'Percentage discount must be between 1% and 100%.');
                    isValid = false;
                } else {
                    clearFieldError(valueEl, valueErrorEl);
                }
            } else {
                clearFieldError(valueEl, valueErrorEl);
            }

            // Cross-field check for Fixed discount
            if (type === 'Fixed' && !isNaN(val) && val > 0) {
                if (minOrder <= val) {
                    showFieldError(minOrderEl, minOrderErrorEl, `Minimum order amount must be greater than discount (₹${val}).`);
                    isValid = false;
                } else {
                    clearFieldError(minOrderEl, minOrderErrorEl);
                }
            } else {
                if (minOrder < 0) {
                    showFieldError(minOrderEl, minOrderErrorEl, 'Minimum order cannot be negative.');
                    isValid = false;
                } else {
                    clearFieldError(minOrderEl, minOrderErrorEl);
                }
            }

            return isValid;
        }

        function validateUsageCountField(inputEl, errorEl) {
            const count = parseInt(inputEl.value, 10);
            if (isNaN(count) || count < 1 || count > 5 || !Number.isInteger(parseFloat(inputEl.value))) {
                showFieldError(inputEl, errorEl, 'Usage limit must be an integer between 1 and 5.');
                return false;
            }
            clearFieldError(inputEl, errorEl);
            return true;
        }

        function validateDates(startEl, endEl, startErrorEl, endErrorEl) {
            const startDate = startEl.value;
            const endDate = endEl.value;
            let isValid = true;

            if (!startDate) {
                showFieldError(startEl, startErrorEl, 'Start Date is required.');
                isValid = false;
            } else {
                clearFieldError(startEl, startErrorEl);
            }

            if (!endDate) {
                showFieldError(endEl, endErrorEl, 'End Date is required.');
                isValid = false;
            } else {
                clearFieldError(endEl, endErrorEl);
            }

            if (startDate && endDate) {
                if (new Date(endDate) <= new Date(startDate)) {
                    showFieldError(endEl, endErrorEl, 'End Date must be strictly after Start Date.');
                    isValid = false;
                } else {
                    clearFieldError(endEl, endErrorEl);
                }
            }

            return isValid;
        }

        function showFieldError(inputEl, errorEl, msg) {
            inputEl.classList.add('is-invalid');
            inputEl.classList.remove('is-valid');
            if (errorEl) {
                errorEl.textContent = msg;
                errorEl.classList.add('visible');
            }
        }

        function clearFieldError(inputEl, errorEl) {
            inputEl.classList.remove('is-invalid');
            inputEl.classList.add('is-valid');
            if (errorEl) {
                errorEl.textContent = '';
                errorEl.classList.remove('visible');
            }
        }

        // --- Setup Add Modal Listeners ---
        const addCode = document.getElementById('addCode');
        const addCodeError = document.getElementById('addCodeError');
        const addType = document.getElementById('addDiscountType');
        const addVal = document.getElementById('addDiscountValue');
        const addValLabel = document.getElementById('addDiscountValueLabel');
        const addValHint = document.getElementById('addDiscountValueHint');
        const addValError = document.getElementById('addDiscountValueError');
        const addMinOrder = document.getElementById('addMinimumOrderAmount');
        const addMinOrderError = document.getElementById('addMinimumOrderAmountError');
        const addMaxWrapper = document.getElementById('addMaxDiscountWrapper');
        const addUsage = document.getElementById('addUsageCount');
        const addUsageError = document.getElementById('addUsageCountError');
        const addStart = document.getElementById('addStartDate');
        const addStartError = document.getElementById('addStartDateError');
        const addEnd = document.getElementById('addEndDate');
        const addEndError = document.getElementById('addEndDateError');

        addCode.addEventListener('input', () => validateCodeField(addCode, addCodeError));
        addUsage.addEventListener('input', () => validateUsageCountField(addUsage, addUsageError));

        addType.addEventListener('change', () => {
            if (addType.value === 'Percentage') {
                addMaxWrapper.style.display = 'block';
                addValLabel.innerHTML = 'Discount Percentage (%) <span class="text-danger">*</span>';
                addValHint.textContent = 'Must be between 1% and 100%.';
            } else {
                addMaxWrapper.style.display = 'none';
                addValLabel.innerHTML = 'Discount Amount (₹) <span class="text-danger">*</span>';
                addValHint.textContent = 'Fixed amount in ₹ (must be < Minimum Order).';
            }
            validateDiscountFields(addType, addVal, addMinOrder, null, addValError, addMinOrderError);
        });

        addVal.addEventListener('input', () => validateDiscountFields(addType, addVal, addMinOrder, null, addValError, addMinOrderError));
        addMinOrder.addEventListener('input', () => validateDiscountFields(addType, addVal, addMinOrder, null, addValError, addMinOrderError));

        addStart.addEventListener('change', () => {
            if (addStart.value) {
                addEnd.min = addStart.value;
            }
            validateDates(addStart, addEnd, addStartError, addEndError);
        });
        addEnd.addEventListener('change', () => validateDates(addStart, addEnd, addStartError, addEndError));

        // Submit Add Form
        document.getElementById('addCouponForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const isCodeValid = validateCodeField(addCode, addCodeError);
            const isDiscountValid = validateDiscountFields(addType, addVal, addMinOrder, null, addValError, addMinOrderError);
            const isUsageValid = validateUsageCountField(addUsage, addUsageError);
            const isDatesValid = validateDates(addStart, addEnd, addStartError, addEndError);

            if (!isCodeValid || !isDiscountValid || !isUsageValid || !isDatesValid) {
                return Swal.fire({
                    icon: 'warning',
                    title: 'Invalid Input',
                    text: 'Please correct the highlighted errors before submitting.',
                    confirmButtonColor: '#2563eb'
                });
            }

            const formData = new FormData(this);
            const payload = Object.fromEntries(formData.entries());

            const submitBtn = document.getElementById('addCouponSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';

            try {
                const res = await fetch('/admin/addcoupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (res.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: result.message,
                        confirmButtonColor: '#2563eb'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: result.message || 'Failed to create coupon.',
                        confirmButtonColor: '#ef4444'
                    });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Request Failed',
                    text: 'An unexpected network error occurred.',
                    confirmButtonColor: '#ef4444'
                });
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Create Coupon';
            }
        });

        // --- Setup Edit Modal Listeners ---
        const editModal = new bootstrap.Modal(document.getElementById('editCouponModal'));
        const editCode = document.getElementById('editCode');
        const editCodeError = document.getElementById('editCodeError');
        const editType = document.getElementById('editDiscountType');
        const editVal = document.getElementById('editDiscountValue');
        const editValLabel = document.getElementById('editDiscountValueLabel');
        const editValHint = document.getElementById('editDiscountValueHint');
        const editValError = document.getElementById('editDiscountValueError');
        const editMinOrder = document.getElementById('editMinimumOrderAmount');
        const editMinOrderError = document.getElementById('editMinimumOrderAmountError');
        const editMaxWrapper = document.getElementById('editMaxDiscountWrapper');
        const editUsage = document.getElementById('editUsageCount');
        const editUsageError = document.getElementById('editUsageCountError');
        const editStart = document.getElementById('editStartDate');
        const editStartError = document.getElementById('editStartDateError');
        const editEnd = document.getElementById('editEndDate');
        const editEndError = document.getElementById('editEndDateError');

        editCode.addEventListener('input', () => validateCodeField(editCode, editCodeError));
        editUsage.addEventListener('input', () => validateUsageCountField(editUsage, editUsageError));

        editType.addEventListener('change', () => {
            if (editType.value === 'Percentage') {
                editMaxWrapper.style.display = 'block';
                editValLabel.innerHTML = 'Discount Percentage (%) <span class="text-danger">*</span>';
                editValHint.textContent = 'Must be between 1% and 100%.';
            } else {
                editMaxWrapper.style.display = 'none';
                editValLabel.innerHTML = 'Discount Amount (₹) <span class="text-danger">*</span>';
                editValHint.textContent = 'Fixed amount in ₹ (must be < Minimum Order).';
            }
            validateDiscountFields(editType, editVal, editMinOrder, null, editValError, editMinOrderError);
        });

        editVal.addEventListener('input', () => validateDiscountFields(editType, editVal, editMinOrder, null, editValError, editMinOrderError));
        editMinOrder.addEventListener('input', () => validateDiscountFields(editType, editVal, editMinOrder, null, editValError, editMinOrderError));

        editStart.addEventListener('change', () => {
            if (editStart.value) {
                editEnd.min = editStart.value;
            }
            validateDates(editStart, editEnd, editStartError, editEndError);
        });
        editEnd.addEventListener('change', () => validateDates(editStart, editEnd, editStartError, editEndError));

        async function openEditCouponModal(couponId) {
            try {
                const res = await fetch(`/admin/coupons/${couponId}`);
                if (!res.ok) throw new Error('Could not fetch coupon details');
                const coupon = await res.json();

                document.getElementById('editCouponId').value = coupon._id;
                editCode.value = coupon.code;
                editType.value = coupon.discountType;
                editVal.value = coupon.discountValue;
                document.getElementById('editMaxDiscountAmount').value = coupon.maxDiscountAmount || '';
                editMinOrder.value = coupon.minimumOrderAmount;
                editUsage.value = coupon.usageCount;

                if (coupon.startDate) {
                    editStart.value = new Date(coupon.startDate).toISOString().split('T')[0];
                }
                if (coupon.endDate) {
                    editEnd.value = new Date(coupon.endDate).toISOString().split('T')[0];
                }

                // Trigger change event to toggle max discount visibility
                editType.dispatchEvent(new Event('change'));

                // Reset error highlights
                [editCode, editVal, editMinOrder, editUsage, editStart, editEnd].forEach(el => {
                    el.classList.remove('is-invalid', 'is-valid');
                });
                document.querySelectorAll('#editCouponModal .error-feedback').forEach(el => el.classList.remove('visible'));

                editModal.show();
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to load coupon details for editing.',
                    confirmButtonColor: '#ef4444'
                });
            }
        }

        // Submit Edit Form
        document.getElementById('editCouponForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const isCodeValid = validateCodeField(editCode, editCodeError);
            const isDiscountValid = validateDiscountFields(editType, editVal, editMinOrder, null, editValError, editMinOrderError);
            const isUsageValid = validateUsageCountField(editUsage, editUsageError);
            const isDatesValid = validateDates(editStart, editEnd, editStartError, editEndError);

            if (!isCodeValid || !isDiscountValid || !isUsageValid || !isDatesValid) {
                return Swal.fire({
                    icon: 'warning',
                    title: 'Invalid Input',
                    text: 'Please correct the highlighted errors before submitting.',
                    confirmButtonColor: '#2563eb'
                });
            }

            const formData = new FormData(this);
            const payload = Object.fromEntries(formData.entries());
            const couponId = document.getElementById('editCouponId').value;

            const submitBtn = document.getElementById('editCouponSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

            try {
                const res = await fetch(`/admin/editcoupon/${couponId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (res.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: result.message,
                        confirmButtonColor: '#2563eb'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: result.message || 'Failed to update coupon.',
                        confirmButtonColor: '#ef4444'
                    });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Request Failed',
                    text: 'An unexpected network error occurred.',
                    confirmButtonColor: '#ef4444'
                });
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Save Changes';
            }
        });

        // Delete Coupon confirmation
        async function confirmDeleteCoupon(id, code) {
            const result = await Swal.fire({
                title: 'Delete Coupon?',
                text: `Are you sure you want to permanently delete coupon "${code}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete It'
            });

            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/admin/deletecoupon/${id}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: data.message,
                            confirmButtonColor: '#2563eb'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message || 'Failed to delete coupon.',
                            confirmButtonColor: '#ef4444'
                        });
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Request Failed',
                        text: 'Failed to connect to the server.',
                        confirmButtonColor: '#ef4444'
                    });
                }
            }
        }
    </script>
</body>
</html>