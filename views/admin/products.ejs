<div>
    <!-- include the sidebar partial -->
    <%- include('sidebar') %>

    <!-- Header / Navbar -->
    <div class="fixed top-0 left-0 right-0 z-10 flex items-center justify-between px-8 h-20 shadow-sm ml-64 bg-white border-b border-gray-200">
        <div>
            <h1 class="text-xl font-bold text-gray-800">Products Management</h1>
            <p class="text-xs text-gray-500 mt-0.5">Manage your catalog, stock levels, and pricing</p>
        </div>
        <div class="flex items-center space-x-4">
            <!-- Search Form -->
            <form action="/admin/products" method="GET" class="relative">
                <input
                    type="text"
                    name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Search by product name..."
                    class="pl-10 pr-4 py-2 w-72 md:w-80 h-10 text-sm rounded-lg bg-gray-50 border border-gray-300 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                />
                <i class="fa fa-search absolute left-3.5 top-3 text-gray-400 text-sm"></i>
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/admin/products" class="absolute right-3 top-2.5 text-xs text-gray-400 hover:text-red-500" title="Clear search">
                        <i class="fa fa-times-circle"></i>
                    </a>
                <% } %>
            </form>

            <!-- Add Product Button -->
            <a href="/admin/addproduct" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow transition">
                <i class="fa fa-plus me-2"></i>Add New Product
            </a>
        </div>
    </div>

    <!-- Main Content Container -->
    <div class="pt-28 pb-16 px-8 max-w-7xl mx-auto">
        <!-- Stats / Quick Info Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6 bg-white p-4 rounded-xl shadow-sm border border-gray-200">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg">
                    <i class="fa fa-boxes"></i>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-800">
                        Total Products: <span class="text-blue-600"><%= typeof totalProducts !== 'undefined' ? totalProducts : products.length %></span>
                    </h3>
                    <% if (typeof search !== 'undefined' && search) { %>
                        <p class="text-xs text-gray-500">Filtered results for "<%= search %>"</p>
                    <% } else { %>
                        <p class="text-xs text-gray-500">Showing 10 items per page</p>
                    <% } %>
                </div>
            </div>
            <% if (typeof search !== 'undefined' && search) { %>
                <a href="/admin/products" class="text-xs font-medium text-blue-600 hover:text-blue-800 underline">
                    Clear Search Filter
                </a>
            <% } %>
        </div>

        <!-- Products Table Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            <th class="py-4 px-4 w-12 text-center">#</th>
                            <th class="py-4 px-4 w-20 text-center">Image</th>
                            <th class="py-4 px-4">Product Name</th>
                            <th class="py-4 px-4">Category</th>
                            <th class="py-4 px-4 text-center">Stock</th>
                            <th class="py-4 px-4">Price / Discount</th>
                            <th class="py-4 px-4 text-center">Status</th>
                            <th class="py-4 px-6 text-center w-48">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        <% if (products && products.length > 0) { %>
                            <% products.forEach((product, index) => { %>
                                <tr class="hover:bg-blue-50/40 transition-colors">
                                    <!-- Index -->
                                    <td class="py-3 px-4 text-center font-medium text-gray-500 text-xs">
                                        <%= ((currentPage - 1) * limit) + index + 1 %>
                                    </td>

                                    <!-- Product Thumbnail -->
                                    <td class="py-3 px-4 text-center">
                                        <div class="w-14 h-14 rounded-lg bg-gray-100 border border-gray-200 overflow-hidden flex items-center justify-center mx-auto shadow-sm">
                                            <% if (product.imgArray && product.imgArray.length > 0) { %>
                                                <img src="/uploads/<%= product.imgArray[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='https://placehold.co/100x100?text=No+Img';">
                                            <% } else { %>
                                                <i class="fa fa-image text-gray-300 text-xl"></i>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Product Name -->
                                    <td class="py-3 px-4">
                                        <div class="font-semibold text-gray-900 line-clamp-1 max-w-xs" title="<%= product.name %>">
                                            <%= product.name %>
                                        </div>
                                        <p class="text-xs text-gray-400 line-clamp-1 max-w-xs mt-0.5"><%= product.description || '' %></p>
                                    </td>

                                    <!-- Category -->
                                    <td class="py-3 px-4">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= product.category ? 'bg-indigo-50 text-indigo-700 border border-indigo-100' : 'bg-gray-100 text-gray-600' %>">
                                            <%= product.category ? product.category.name : 'Uncategorized' %>
                                        </span>
                                    </td>

                                    <!-- Stock -->
                                    <td class="py-3 px-4 text-center">
                                        <% if (product.stock === 0) { %>
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700">
                                                Out of Stock (0)
                                            </span>
                                        <% } else if (product.stock < 10) { %>
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
                                                Low (<%= product.stock %>)
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
                                                <%= product.stock %> in stock
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- Price & Discount -->
                                    <td class="py-3 px-4">
                                        <div class="font-bold text-gray-900">
                                            ₹<%= (product.finalPrice || product.price).toLocaleString('en-IN') %>
                                        </div>
                                        <% if (product.discount && product.discount > 0) { %>
                                            <div class="flex items-center space-x-1.5 mt-0.5 text-xs">
                                                <span class="text-gray-400 line-through">₹<%= product.price.toLocaleString('en-IN') %></span>
                                                <span class="text-emerald-600 font-semibold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100">
                                                    <%= product.discount %>% off
                                                </span>
                                            </div>
                                        <% } %>
                                    </td>

                                    <!-- Status -->
                                    <td class="py-3 px-4 text-center">
                                        <% if (product.isActive) { %>
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 me-1.5"></span>
                                                Active
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-red-500 me-1.5"></span>
                                                Blocked
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="py-3 px-6 text-center">
                                        <div class="flex items-center justify-center space-x-2">
                                            <!-- Edit Button -->
                                            <a href="/admin/updateproduct/<%= product.id %>" class="inline-flex items-center px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium rounded-lg transition shadow-sm" title="Edit Product">
                                                <i class="fa fa-pencil-alt me-1 text-gray-500"></i>Edit
                                            </a>

                                            <!-- Block/Unblock Toggle Button -->
                                            <button
                                                type="button"
                                                class="block-unblock-btn inline-flex items-center px-2.5 py-1.5 text-xs font-medium rounded-lg transition shadow-sm <%= product.isActive ? 'bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200' %>"
                                                data-product-id="<%= product.id %>"
                                                data-product-name="<%= product.name %>"
                                                data-active="<%= product.isActive %>"
                                                title="<%= product.isActive ? 'Block Product' : 'Unblock Product' %>">
                                                <i class="fa <%= product.isActive ? 'fa-ban text-amber-600' : 'fa-check text-emerald-600' %> me-1"></i>
                                                <%= product.isActive ? 'Block' : 'Unblock' %>
                                            </button>

                                            <!-- Delete Button -->
                                            <button
                                                type="button"
                                                class="delete-product-btn inline-flex items-center px-2.5 py-1.5 text-xs font-medium rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 transition shadow-sm"
                                                data-product-id="<%= product.id %>"
                                                data-product-name="<%= product.name %>"
                                                title="Delete Product">
                                                <i class="fa fa-trash-alt me-1 text-red-500"></i>Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="py-16 text-center">
                                    <div class="max-w-sm mx-auto">
                                        <div class="w-16 h-16 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                                            <i class="fa fa-box-open"></i>
                                        </div>
                                        <h3 class="text-base font-semibold text-gray-800 mb-1">No products found</h3>
                                        <p class="text-xs text-gray-500 mb-4">
                                            <% if (typeof search !== 'undefined' && search) { %>
                                                No products match your search query "<%= search %>".
                                            <% } else { %>
                                                You haven't added any products to your catalog yet.
                                            <% } %>
                                        </p>
                                        <% if (typeof search !== 'undefined' && search) { %>
                                            <a href="/admin/products" class="inline-flex items-center px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs font-semibold rounded-lg transition">
                                                Clear Search
                                            </a>
                                        <% } else { %>
                                            <a href="/admin/addproduct" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow transition">
                                                <i class="fa fa-plus me-1.5"></i>Add Your First Product
                                            </a>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <% if (totalPages > 1) { %>
                <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-wrap items-center justify-between gap-4">
                    <p class="text-xs text-gray-600">
                        Page <span class="font-semibold"><%= currentPage %></span> of <span class="font-semibold"><%= totalPages %></span>
                    </p>

                    <div class="flex items-center space-x-1.5">
                        <!-- Previous Page -->
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="px-3 py-1.5 text-xs font-medium rounded bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition shadow-sm">
                                <i class="fa fa-chevron-left me-1"></i> Prev
                            </a>
                        <% } else { %>
                            <span class="px-3 py-1.5 text-xs font-medium rounded bg-gray-100 border border-gray-200 text-gray-400 cursor-not-allowed">
                                <i class="fa fa-chevron-left me-1"></i> Prev
                            </span>
                        <% } %>

                        <!-- Page Numbers -->
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="px-3 py-1.5 text-xs font-bold rounded bg-blue-600 text-white shadow-sm">
                                    <%= i %>
                                </span>
                            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                                <a href="?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="px-3 py-1.5 text-xs font-medium rounded bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition shadow-sm">
                                    <%= i %>
                                </a>
                            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                                <span class="px-2 text-xs text-gray-400">...</span>
                            <% } %>
                        <% } %>

                        <!-- Next Page -->
                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="px-3 py-1.5 text-xs font-medium rounded bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition shadow-sm">
                                Next <i class="fa fa-chevron-right ms-1"></i>
                            </a>
                        <% } else { %>
                            <span class="px-3 py-1.5 text-xs font-medium rounded bg-gray-100 border border-gray-200 text-gray-400 cursor-not-allowed">
                                Next <i class="fa fa-chevron-right ms-1"></i>
                            </span>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Script for Block/Unblock and Delete Actions with SweetAlert -->
    <script>
        // Block / Unblock Toggle Handler
        document.querySelectorAll('.block-unblock-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const productId = this.getAttribute('data-product-id');
                const productName = this.getAttribute('data-product-name') || 'this product';
                const isActive = this.getAttribute('data-active') === 'true';
                const actionVerb = isActive ? 'Block' : 'Unblock';

                const result = await Swal.fire({
                    title: `${actionVerb} Product?`,
                    text: `Are you sure you want to ${actionVerb.toLowerCase()} "${productName}"?`,
                    icon: isActive ? 'warning' : 'question',
                    showCancelButton: true,
                    confirmButtonColor: isActive ? '#d97706' : '#10b981',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: `Yes, ${actionVerb}!`,
                    cancelButtonText: 'Cancel'
                });

                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/products/${productId}/block`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ active: !isActive })
                        });

                        const resData = await response.json();

                        if (response.ok && resData.success !== false) {
                            Swal.fire({
                                icon: 'success',
                                title: `Product ${isActive ? 'Blocked' : 'Unblocked'}!`,
                                text: resData.message || `The product has been ${isActive ? 'blocked' : 'unblocked'} successfully.`,
                                timer: 1500,
                                showConfirmButton: false
                            });

                            setTimeout(() => {
                                window.location.reload();
                            }, 1200);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Action Failed',
                                text: resData.message || 'Could not update product status.'
                            });
                        }
                    } catch (err) {
                        console.error('Error toggling product status:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Server Error',
                            text: 'Something went wrong while communicating with the server.'
                        });
                    }
                }
            });
        });

        // Delete Product Handler
        document.querySelectorAll('.delete-product-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const productId = this.getAttribute('data-product-id');
                const productName = this.getAttribute('data-product-name') || 'this product';

                const result = await Swal.fire({
                    title: 'Delete Product?',
                    text: `Are you sure you want to permanently delete "${productName}"? This action cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Yes, Delete Permanently',
                    cancelButtonText: 'Cancel'
                });

                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/products/${productId}/delete`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        const resData = await response.json();

                        if (response.ok && resData.success !== false) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: resData.message || 'Product deleted successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            });

                            setTimeout(() => {
                                window.location.reload();
                            }, 1200);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Delete Failed',
                                text: resData.message || 'Could not delete product.'
                            });
                        }
                    } catch (err) {
                        console.error('Error deleting product:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Server Error',
                            text: 'Something went wrong while communicating with the server.'
                        });
                    }
                }
            });
        });
    </script>
</div>