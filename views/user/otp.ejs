<%- include('navbar') %>

<style>
.otp-field {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: nowrap;
}

.otp-field input {
  width: 48px;
  height: 56px;
  text-align: center;
  font-size: 22px;
  font-weight: 600;
  border: 2px solid #ced4da;
  border-radius: 10px;
  margin: 0;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
  caret-color: #1A5319;
}

.otp-field input:focus {
  border-color: #1A5319;
  box-shadow: 0 0 0 3px rgba(26, 83, 25, 0.15);
}

@media (max-width: 576px) {
  .otp-field {
    gap: 8px;
  }

  .otp-field input {
    width: 40px;
    height: 48px;
    font-size: 18px;
  }
}

.disabled-link {
  pointer-events: none;
  color: #ccc;
}

.enabled-link {
  color: #1A5319;
  text-decoration: underline;
}
</style>

<section class="container-fluid d-block">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card bg-white mb-5 mt-5 border-0" style="box-shadow: 0 12px 15px rgba(0, 0, 0, 0.02);">
        <div class="card-body p-5 text-center">
          <h4>Verify</h4>
          <p>Your code was sent to you via <%= email %></p>
          <% if (typeof mailWarning !== 'undefined' && mailWarning) { %>
            <p class="text-danger small">Email delivery failed. Check the server console for the OTP (dev fallback), or update the Gmail App Password in .env.</p>
          <% } %>
          <form action="/otp" method="post" id="otp-form">
            <div class="otp-field mb-4" id="otp-inputs">
              <input type="text" name="otp1" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1">
              <input type="text" name="otp2" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 2">
              <input type="text" name="otp3" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 3">
              <input type="text" name="otp4" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 4">
              <input type="text" name="otp5" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 5">
            </div>
            <input type="hidden" name="otp" id="otp">
            <input type="hidden" name="otpTime" value="<%= otpTime %>" id="otpTime">
            <button class="btn btn-primary mb-3" type="submit">
             Verify
            </button>
          </form>
          <p class="resend text-muted mb-0">
            Didn't receive code? <a href="/resend" id="resend-link" class="disabled-link">Request again</a>
          </p>
          <div id="otp-timer" class="mt-3">
            <p id="timer-text">Time left: <span id="timer">02:00</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const OTP_DURATION_MS = 2 * 60 * 1000;
  const otpIssuedAt = parseInt(document.getElementById('otpTime').value, 10) || Date.now();
  const otpInputs = Array.from(document.querySelectorAll('#otp-inputs input'));

  function getRemainingSeconds() {
    return Math.max(0, Math.ceil((OTP_DURATION_MS - (Date.now() - otpIssuedAt)) / 1000));
  }

  function formatTime(seconds) {
    const minutes = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  function enableResend() {
    const resendLink = document.getElementById('resend-link');
    resendLink.classList.remove('disabled-link');
    resendLink.classList.add('enabled-link');
    resendLink.style.pointerEvents = 'auto';
  }

  function updateTimer() {
    const timerElement = document.getElementById('timer');
    const remaining = getRemainingSeconds();

    if (remaining <= 0) {
      clearInterval(timerInterval);
      timerElement.textContent = '00:00';
      enableResend();
      return;
    }

    timerElement.textContent = formatTime(remaining);
  }

  function fillOtpFromString(value) {
    const digits = String(value).replace(/\D/g, '').slice(0, otpInputs.length).split('');
    otpInputs.forEach((input, i) => {
      input.value = digits[i] || '';
    });
    const focusIndex = Math.min(digits.length, otpInputs.length - 1);
    otpInputs[focusIndex].focus();
  }

  otpInputs.forEach((input, index) => {
    input.addEventListener('input', (e) => {
      const raw = e.target.value.replace(/\D/g, '');

      // SMS autofill / paste into one box with full code
      if (raw.length > 1) {
        fillOtpFromString(raw);
        return;
      }

      e.target.value = raw.slice(0, 1);

      if (e.target.value && index < otpInputs.length - 1) {
        otpInputs[index + 1].focus();
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && index > 0) {
        otpInputs[index - 1].focus();
        otpInputs[index - 1].value = '';
        e.preventDefault();
      }

      if (e.key === 'ArrowLeft' && index > 0) {
        otpInputs[index - 1].focus();
        e.preventDefault();
      }

      if (e.key === 'ArrowRight' && index < otpInputs.length - 1) {
        otpInputs[index + 1].focus();
        e.preventDefault();
      }
    });

    input.addEventListener('paste', (e) => {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text');
      fillOtpFromString(pasted);
    });

    input.addEventListener('focus', () => {
      input.select();
    });
  });

  if (otpInputs.length) {
    otpInputs[0].focus();
  }

  const timerInterval = setInterval(updateTimer, 1000);
  updateTimer();

  document.getElementById('otp-form').addEventListener('submit', function(event) {
    event.preventDefault();

    const otpValues = otpInputs.map((input) => input.value.trim()).join('');
    document.getElementById('otp').value = otpValues;

    if (otpValues.length === 5) {
      this.submit();
    } else {
      alert('Please enter a valid OTP.');
      const empty = otpInputs.find((input) => !input.value);
      if (empty) empty.focus();
    }
  });
</script>

<%- include('footer') %>
