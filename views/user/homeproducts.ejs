<style>
@import url("https://fonts.googleapis.com/css?family=Open+Sans:400,700&display=swap");

.home-products {
    --first-color: #ffffff;
    --accent-color: rgb(26, 83, 25);
    width: 100%;
    max-width: 1200px;
    margin: 2.5rem auto 2rem;
    padding: 0 1rem;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    clear: both;
    overflow: visible;
}

.home-products *,
.home-products *::before,
.home-products *::after {
    box-sizing: border-box;
}

.home-products .title-shop {
    position: relative;
    margin: 0 0 1.75rem;
    font-size: clamp(1.35rem, 2vw + 0.8rem, 1.85rem);
    font-weight: bold;
    text-align: center;
    color: var(--accent-color);
}

.home-products-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    margin: 0;
    padding: 0;
}

.home-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 1.1rem 1.25rem;
    border-radius: 0.8rem;
    overflow: hidden;
    background-color: var(--first-color);
    border: 1px solid rgba(26, 83, 25, 0.12);
    box-shadow: 0 0 5px rgba(26, 83, 25, 0.25);
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: 100%;
    margin: 0;
}

.home-product-card .card__img {
    width: 100%;
    max-height: 200px;
    overflow: hidden;
    border-radius: 0.5rem;
}

.home-product-card .card__img img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
}

.home-product-card .card__name {
    display: none;
}

.home-product-card .card__title {
    width: 100%;
    margin: 0.85rem 0 0.35rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-color);
    text-align: center;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.home-product-card .card__precis {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
}

.home-product-card .card__preci--now {
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--accent-color);
}

.home-product-card .card_precise_stock {
    margin-top: 0.85rem;
    width: 100%;
    text-align: center;
}

.home-product-card:hover {
    background-color: rgb(214, 239, 216);
}

.home-product-card:hover .card__img img {
    transform: scale(1.06);
}

@media (max-width: 1199.98px) {
    .home-products-row {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
    }
}

@media (max-width: 991.98px) {
    .home-products {
        margin-top: 2rem;
        padding: 0 1rem;
    }

    .home-products-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.15rem;
    }
}

@media (max-width: 575.98px) {
    .home-products {
        margin-top: 1.5rem;
        padding: 0 1rem;
    }

    .home-products-row {
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        max-width: 100%;
    }

    .home-product-card {
        padding: 0.85rem 0.9rem 1.1rem;
    }

    .home-product-card .card__img img {
        height: 180px;
    }
}
</style>

<section class="home-products">
    <h2 class="title-shop">Featured Products</h2>
    <div class="home-products-row">
        <% products.slice(0, 10).forEach(product => { %>
            <article class="home-product-card">
                <div class="card__img">
                    <img src="<%='/uploads/' + product.imgArray[0] %>" alt="<%= product.name %>">
                </div>
                <h3 class="card__title"><%= product.name %></h3>
                <div class="card__precis">
                    <span class="card__preci--now">$<%= product.finalPrice %></span>
                    <form class="wishlist-form" data-id="<%= product._id %>" style="display: inline; margin: 0;">
                        <button type="button" class="btn btn-link wishlist-btn" style="padding: 0; background: none; border: none;" aria-label="Add to wishlist">
                            <i class="fas fa-heart" style="color: red;"></i>
                        </button>
                    </form>
                </div>
                <div class="card_precise_stock">
                    <% if (product.stock > 0) { %>
                        <a href="/product/<%= product._id %>" class="btn btn-outline-success" style="background-color: rgb(26, 83, 25); color: white;">
                            Detailed View
                        </a>
                    <% } else { %>
                        <a href="#" class="btn btn-outline-danger" style="background-color: red; color: white;" onclick="return false;">
                            Out of Stock
                        </a>
                    <% } %>
                </div>
            </article>
        <% }) %>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.home-products .wishlist-form').forEach(form => {
            form.querySelector('.wishlist-btn').addEventListener('click', function () {
                const productId = form.getAttribute('data-id');

                fetch(`/add-wishlist/${productId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId })
                })
                .then(response => response.json())
                .then(data => {
                    Swal.fire({
                        toast: true,
                        icon: data.success ? 'success' : 'error',
                        title: data.success ? 'Product added to wishlist!' : 'Failed to add product to wishlist!',
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                    });
                })
                .catch(() => {
                    Swal.fire({
                        toast: true,
                        icon: 'error',
                        title: 'An error occurred!',
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                    });
                });
            });
        });
    });
</script>
